# 环境变量 Schema 校验见 src/config/env.validation.ts,
# 对应 docs/02-architecture/ARCHITECTURE.md 第 7 节。

NODE_ENV=development
# 3000 已被 apps/web(Next.js 默认端口)占用,API 固定使用 3001
PORT=3001

# 与根目录 docker-compose.yml 中的 postgres 服务对应
DATABASE_URL=postgresql://gearblindbox:gearblindbox@localhost:5432/gearblindbox?schema=public

# 与根目录 docker-compose.yml 中的 redis 服务对应
REDIS_URL=redis://localhost:6379
