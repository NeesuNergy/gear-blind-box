// Prisma Schema
// 对应 docs/03-spec/DATA-MODEL.md。
// 官方装备配置存 DB(见 ADR-0002 / CONFIG-SCHEMA.md v0.3)。
// UserScheme 为后续版本预留,V0.1 不建表。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 官方配置版本标签单例(id 固定为 "official")。
model ConfigRevision {
  id         String   @id
  versionTag String   @map("version_tag")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("config_revisions")
}

/// 官方默认装备/干员池。
model GearItem {
  id          String  @id
  category    String
  name        String
  subCategory String? @map("sub_category")
  baseScore   Int     @map("base_score")
  rarity      String?
  weight      Float   @default(1)
  imageUrl    String? @map("image_url")
  description String?
  enabled     Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([category, enabled])
  @@map("gear_items")
}

/// 官方评分权重单例(id 固定为 "official")。
model ScoreWeightConfig {
  id             String @id
  weaponWeight   Float  @map("weapon_weight")
  helmetWeight   Float  @map("helmet_weight")
  armorWeight    Float  @map("armor_weight")
  operatorWeight Float  @map("operator_weight")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("score_weight_configs")
}

/// 一次抽取的完整记录,存储装备快照而非引用,保证历史结果不受后续配置变更影响。
model DrawRecord {
  id          String @id @default(uuid())
  anonymousId String @map("anonymous_id")
  sessionId   String @map("session_id")

  /// 抽取发生时生效的官方 config_revisions.versionTag
  configVersion String @map("config_version")

  weaponItem   Json @map("weapon_item")
  helmetItem   Json @map("helmet_item")
  armorItem    Json @map("armor_item")
  operatorItem Json @map("operator_item")

  weaponScore   Int @map("weapon_score")
  helmetScore   Int @map("helmet_score")
  armorScore    Int @map("armor_score")
  operatorScore Int @map("operator_score")
  totalScore    Int @map("total_score")

  selectedMinScore Int? @map("selected_min_score")
  selectedMaxScore Int? @map("selected_max_score")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("draw_records")
  @@index([anonymousId, createdAt])
  @@index([createdAt])
}

/// 埋点原始事件。
model AnalyticsEvent {
  id          String @id @default(uuid())
  eventName   String @map("event_name")
  anonymousId String @map("anonymous_id")
  sessionId   String @map("session_id")

  properties Json? @map("properties")

  ipHash    String? @map("ip_hash")
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("analytics_events")
  @@index([anonymousId, createdAt])
  @@index([eventName, createdAt])
}

/// 每日聚合指标。
model DailyMetricSummary {
  date DateTime @id @db.Date

  pv                    Int @map("pv")
  uv                    Int @map("uv")
  drawCount             Int @map("draw_count")
  newVisitorCount       Int @map("new_visitor_count")
  returningVisitorCount Int @map("returning_visitor_count")
  d1RetainedCount       Int @map("d1_retained_count")

  @@map("daily_metric_summaries")
}
