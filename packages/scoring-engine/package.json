{
  "name": "@gearblindbox/scoring-engine",
  "version": "0.1.0",
  "description": "评分引擎:纯函数实现综合评分计算与评分区间抽取算法,对应 docs/03-spec/SCORING-SPEC.md。不依赖数据库/HTTP/文件系统,便于独立单测。",
  "private": true,
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -w -p tsconfig.json",
    "lint": "eslint . -c ../../eslint.config.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@gearblindbox/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.4",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
